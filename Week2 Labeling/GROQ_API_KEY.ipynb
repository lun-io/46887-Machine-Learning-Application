        "from google.colab import userdata\n",
        "import requests\n",
        "\n",
        "key = userdata.get(\"GROQ-API-KEY\")\n",
        "r = requests.get(\n",
        "    \"https://api.groq.com/openai/v1/models\",\n",
        "    headers={\"Authorization\": f\"Bearer {key}\"},\n",
        ")\n",
        "print(r.status_code)\n"
      ]
